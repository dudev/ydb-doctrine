<?xml version="1.0" encoding="utf-8"?>
<phpunit bootstrap="tests/bootstrap.php" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.3/phpunit.xsd">
  <coverage>
    <include>
      <directory suffix=".php">./src/</directory>
    </include>
  </coverage>
  <testsuites>
    <testsuite name="tests">
      <!--
        Two suffixes because the codebase mixes both conventions: unit tests are
        named *Test.php, functional (live-YDB) tests are named *TestCase.php.
        A bare <directory> defaults to matching only *Test.php, which silently
        skipped every functional test (Fuctional/*TestCase.php); confirmed via
        the list tests option showing zero of them despite a plain run reporting
        a clean pass.
      -->
      <directory suffix="Test.php">./tests/</directory>
      <directory suffix="TestCase.php">./tests/</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="YDB_URL" value='ydb://localhost:2136/local?discovery=false&amp;iam_config[anonymous]=true&amp;iam_config[insecure]=true' force="true" />
  </php>
</phpunit>
