{
    "name": "dudev/ydb-doctrine",
    "license": "Apache-2.0",
    "description": "It's driver for YDB https://ydb.tech",
    "autoload": {
        "psr-4": {
            "Dudev\\YdbDoctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dudev\\YdbDoctrine\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "dudev"
        }
    ],
    "scripts": {
        "php-cs-fixer": "php-cs-fixer"
    },
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.4",
        "doctrine/orm": "^3.4,<3.6",
        "ydb-platform/ydb-php-sdk": "^1.2",
        "symfony/cache": "^6.3"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.1",
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^v3.0.0",
        "vimeo/psalm": "^5.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
